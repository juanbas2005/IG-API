# ==========================================================
# INICIAR SESIÓN
# ==========================================================

def iniciar_sesion():

    cuentas = cargar_cuentas()

    if not cuentas:

        print(
            "\nNo hay cuentas guardadas."
        )

        return

    print("\n" + "=" * 60)
    print("                 INICIAR SESIÓN")
    print("=" * 60)

    lista_cuentas = list(
        cuentas.items()
    )

    for i, (nombre, datos) in enumerate(
        lista_cuentas,
        start=1
    ):

        print(
            f"{i}. {nombre} - "
            f"{datos.get('usuario', '')}"
        )

    print("=" * 60)

    opcion = input(
        "\nSelecciona la cuenta: "
    ).strip()

    try:

        indice = int(opcion) - 1

    except ValueError:

        print(
            "\n✗ Debes introducir un número."
        )

        return

    if (
        indice < 0
        or indice >= len(lista_cuentas)
    ):

        print(
            "\n✗ Cuenta no válida."
        )

        return

    nombre_cuenta, datos = (
        lista_cuentas[indice]
    )

    usuario = datos.get(
        "usuario",
        ""
    )

    password = datos.get(
        "contrasena",
        ""
    )

    if not usuario:

        print(
            "\n✗ La cuenta no tiene usuario."
        )

        return

    if not password:

        print(
            "\n✗ La cuenta no tiene contraseña."
        )

        return

    print("\n" + "-" * 60)

    print(
        f"Cuenta seleccionada: {nombre_cuenta}"
    )

    print(
        f"Usuario: {usuario}"
    )

    print("-" * 60)

    try:

        with sync_playwright() as p:

            print(
                "\nAbriendo Google Chrome..."
            )

            browser = p.chromium.launch(
                headless=False,
                channel="chrome"
            )

            context = browser.new_context()

            page = context.new_page()

            try:

                print(
                    "Abriendo página de inicio "
                    "de sesión..."
                )

                page.goto(
                    "https://www.instagram.com/accounts/login/",
                    wait_until="domcontentloaded",
                    timeout=60000
                )

                print(
                    "\nURL actual:"
                )

                print(
                    page.url
                )

                page.wait_for_timeout(
                    5000
                )

                # ==================================================
                # DIAGNÓSTICO
                # ==================================================

                diagnosticar_inputs(
                    page
                )

                # ==================================================
                # USUARIO / CORREO
                # ==================================================

                print(
                    "\nBuscando campo de usuario..."
                )

                usuario_input = (
                    buscar_campo_usuario(page)
                )

                if usuario_input is None:

                    print(
                        "\n✗ No se encontró "
                        "el campo de usuario."
                    )

                    page.screenshot(
                        path="error_login_usuario.png",
                        full_page=True
                    )

                    print(
                        "Se guardó:"
                    )

                    print(
                        os.path.abspath(
                            "error_login_usuario.png"
                        )
                    )

                    input(
                        "\nPulsa ENTER para cerrar Chrome..."
                    )

                    return

                print(
                    "✓ Campo de usuario encontrado."
                )

                usuario_input.fill(
                    usuario
                )

                print(
                    "✓ Usuario/correo rellenado."
                )

                # ==================================================
                # CONTRASEÑA
                # ==================================================

                print(
                    "\nBuscando campo de contraseña..."
