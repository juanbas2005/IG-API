# DIAGNÓSTICO DE BOTONES
# ==========================================================

def diagnosticar_botones(page):

    print(
        "\nBotones encontrados:"
    )

    try:

        botones = page.locator(
            "button, input[type='submit']"
        )

        cantidad = botones.count()

        print(
            f"Cantidad: {cantidad}"
        )

        for i in range(cantidad):

            try:

                elemento = botones.nth(i)

                tag = elemento.evaluate(
                    "(e) => e.tagName"
                )

                texto = ""

                try:

                    texto = elemento.inner_text()

                except Exception:

                    pass

                tipo = elemento.get_attribute(
                    "type"
                )

                disabled = elemento.is_disabled()

                print(
                    f"\n[{i}]"
                )

                print(
                    f"  Tag: {tag}"
                )

                print(
                    f"  Texto: {texto}"
                )

                print(
                    f"  Type: {tipo}"
                )

                print(
                    f"  Disabled: {disabled}"
                )

            except Exception:

                pass

    except Exception as e:

        print(
            "No se pudieron diagnosticar "
            "los botones:"
        )

        print(e)


