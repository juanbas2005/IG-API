        "\nBuscando controles de fecha..."
    )

    mes = page.get_by_role(
        "combobox",
        name="Select Month"
    )

    dia = page.get_by_role(
        "combobox",
        name="Select Day"
    )

    anio = page.get_by_role(
        "combobox",
        name="Select Year"
    )

    mes.wait_for(
        state="visible",
        timeout=10000
    )

    dia.wait_for(
        state="visible",
        timeout=10000
    )

    anio.wait_for(
        state="visible",
        timeout=10000
    )

    print(
        "✓ Controles de fecha encontrados."
    )

    print(
        "\nSeleccionando mes..."
    )

    seleccionar_opcion(
        page,
        mes,
        indice=MES_NACIMIENTO - 1
    )

    print(
        f"✓ Mes seleccionado: "
        f"{MES_NACIMIENTO}"
    )

    print(
        "\nSeleccionando día..."
    )

    seleccionar_opcion(
        page,
        dia,
        indice=DIA_NACIMIENTO - 1
    )

    print(
        f"✓ Día seleccionado: "
        f"{DIA_NACIMIENTO}"
    )

    print(
        "\nSeleccionando año..."
    )

    seleccionar_opcion(
        page,
        anio,
        texto_buscar=str(
            ANIO_NACIMIENTO
        )
    )

    print(
        f"✓ Año seleccionado: "
        f"{ANIO_NACIMIENTO}"
    )


