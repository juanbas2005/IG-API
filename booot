def buscar_campo_usuario(page):

    selectores = [

        # Selector que apareció en tu diagnóstico
        'input[name="email"]',

        'input[name="username"]',

        'input[autocomplete="username"]',

        'input[aria-label*="username" i]',

        'input[placeholder*="username" i]',

        'input[type="text"]'

