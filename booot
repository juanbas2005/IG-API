ARCHIVO_CUENTAS = "cuentas.json"
ARCHIVO_TXT = "cuentas.txt"


# ==========================================================
# SISTEMA DE CUENTAS
# ==========================================================

def cargar_cuentas():

    if not os.path.exists(ARCHIVO_CUENTAS):
        return {}

    try:

        with open(
            ARCHIVO_CUENTAS,
            "r",
            encoding="utf-8"
        ) as archivo:

            datos = json.load(archivo)

            if isinstance(datos, dict):
                return datos

            return {}

    except (json.JSONDecodeError, OSError):

        return {}


def guardar_cuenta(usuario, password):

    cuentas = cargar_cuentas()

    numeros = []

    for nombre in cuentas:

        if nombre.startswith("Cuenta "):

            try:

                numero = int(
                    nombre.replace("Cuenta ", "")
                )

                numeros.append(numero)

            except ValueError:

                pass

    if numeros:

        siguiente_numero = max(numeros) + 1

    else:

        siguiente_numero = 1

    nombre_cuenta = (
        f"Cuenta {siguiente_numero}"
    )

    cuentas[nombre_cuenta] = {

        "usuario": usuario,

        "contrasena": password

    }

    with open(
        ARCHIVO_CUENTAS,
        "w",
        encoding="utf-8"
    ) as archivo:

        json.dump(
            cuentas,
            archivo,
            indent=4,
            ensure_ascii=False
        )

    print(
        f"\n✓ {nombre_cuenta} guardada correctamente."
    )


# ==========================================================
# BORRAR TODAS LAS CUENTAS
# ==========================================================

def borrar_todas_las_cuentas():

    cuentas = cargar_cuentas()

    if not cuentas:

        print(
            "\nNo hay cuentas guardadas para borrar."
        )

        return

    print("\n" + "=" * 60)
    print("             BORRAR TODAS LAS CUENTAS")
    print("=" * 60)

    print(
        f"\nSe encontraron {len(cuentas)} cuenta(s)."
    )

    confirmacion = input(
        "\nEscribe BORRAR para confirmar: "
    ).strip()

    if confirmacion != "BORRAR":

        print(
            "\n✗ Operación cancelada."
        )

        return

    try:

        with open(
            ARCHIVO_CUENTAS,
            "w",
            encoding="utf-8"
        ) as archivo:

            json.dump(
                {},
                archivo,
                indent=4,
                ensure_ascii=False
            )

        print(
            "\n✓ Todas las cuentas fueron eliminadas."
        )

        # También eliminar el TXT si existe
        if os.path.exists(ARCHIVO_TXT):

            try:

                os.remove(
                    ARCHIVO_TXT
                )

                print(
                    "✓ También se eliminó el archivo TXT."
                )

            except OSError as e:

                print(
                    "\n⚠ No se pudo eliminar el TXT:"
                )

                print(e)

    except OSError as e:

        print(
            "\n✗ No se pudieron borrar las cuentas."
        )

        print(e)


# ==========================================================
# EXPORTAR CUENTAS A TXT
# ==========================================================

def exportar_cuentas_txt():

    cuentas = cargar_cuentas()

    if not cuentas:

        print(
            "\nNo hay cuentas guardadas."
        )

        return

    try:

        with open(
            ARCHIVO_TXT,
            "w",
            encoding="utf-8"
        ) as archivo:

            archivo.write(
                "=" * 60 + "\n"
            )

            archivo.write(
                "              CUENTAS GUARDADAS\n"
            )

            archivo.write(
                "=" * 60 + "\n\n"
            )

            for nombre, datos in cuentas.items():

                archivo.write(
                    f"{nombre}\n"
                )

                archivo.write(
                    f"Usuario:     "
                    f"{datos.get('usuario', '')}\n"
                )

                archivo.write(
                    f"Contraseña:  "
                    f"{datos.get('contrasena', '')}\n"
                )

                archivo.write(
                    "-" * 60 + "\n"
                )

        print(
            f"\n✓ Todas las cuentas fueron "
            f"exportadas a '{ARCHIVO_TXT}'."
        )

    except OSError as e:

        print(
            "\n✗ No se pudo crear el archivo TXT."
        )

        print(e)


